# Optional; defaults to .data/cms.sqlite. Use an absolute path in production.
CMS_DB_PATH=.data/cms.sqlite
# Set true behind HTTPS in production; false is necessary for local HTTP.
CMS_SECURE_COOKIES=false
# Default provider. Choose expo only if using Expo Push Tokens.
PUSH_PROVIDER=fcm
# Absolute path to a Firebase service-account JSON file outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
# Alternative: FCM_SERVICE_ACCOUNT_JSON (secret JSON, never commit).
# Server-to-server device API key: generate a random secret of >=32 characters.
# CMS_DEVICE_API_KEY=
# Expo access token, when enhanced push security is enabled.
# EXPO_ACCESS_TOKEN=
