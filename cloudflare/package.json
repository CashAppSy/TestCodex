{
  "name": "nabdh-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "node scripts/check-config.mjs && wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/check-config.mjs && wrangler deploy",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@playwright/test": "1.64.0",
    "miniflare": "5.20261006.0-alpha",
    "typescript": "^5.9.3",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=24"
  }
}
